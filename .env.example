# Copy this file to `.env` for local development, and set the same names in
# Vercel > Project > Settings > Environment Variables (Production, Preview and Development).
# NEVER commit the real .env file.

# Inbox that receives contact-form messages (server-side only, never sent to the browser)
CONTACT_TO_EMAIL=your-private-inbox@example.com

# Gmail account that SENDS the mail, plus its 16-character App Password
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# Optional: comma-separated extra origins allowed to call the /api routes, e.g. your custom domain.
# Your own *.vercel.app domain and localhost are always allowed.
# Example: https://yourname.dev,https://www.yourname.dev
ALLOWED_ORIGINS=

# optional, raises the GitHub rate limit
GITHUB_TOKEN=
